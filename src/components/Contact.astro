---
import { EMAIL, CV_URL } from '../consts';
import { ui } from '../i18n/ui';
import { getLocaleFromPath } from '../i18n/utils';

const lang = getLocaleFromPath(Astro.url.pathname);
const t = ui[lang];

// TODO §10: completar las URLs que faltan.
const profiles: { label: string; href?: string }[] = [
  { label: 'CVUy', href: CV_URL },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=WMAE3soAAAAJ' },
  { label: 'ORCID' },
  { label: 'LinkedIn' },
  { label: 'Bluesky' },
];
---

<ul class="contact-list">
  <li>
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <span class="nota">{t['contact.emailNote']}</span>
  </li>
  {
    profiles.map((p) => (
      <li>
        {p.href ? (
          <a href={p.href} rel="noopener">{p.label}</a>
        ) : (
          <>{p.label} — <span class="nota">{t['contact.pending']}</span></>
        )}
      </li>
    ))
  }
</ul>
