---
import { EMAIL } from '../consts';
import { ui } from '../i18n/ui';
import { getLocaleFromPath } from '../i18n/utils';

const lang = getLocaleFromPath(Astro.url.pathname);
const t = ui[lang];

// TODO §10: completar las URLs que faltan.
const profiles: { label: string; href?: string }[] = [
  {
    label: 'CVUy',
    href: 'https://exportcvuy.anii.org.uy/cv/?7ed9909c3cbde1b8004c19b4613454d8d86bc4f2feb04e77e3dc358d91bd94a82a94a44cb1824e8564a3ac4781ffff721437e6ecec64a9b3329b362b090f4849',
  },
  { label: 'Google Scholar' },
  { label: 'ORCID' },
  { label: 'LinkedIn' },
  { label: 'Bluesky' },
];
---

<ul class="contact-list">
  <li>
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <span class="nota">{t['contact.emailNote']}</span>
  </li>
  {
    profiles.map((p) => (
      <li>
        {p.href ? <a href={p.href}>{p.label}</a> : <>{p.label} — <span class="nota">{t['contact.pending']}</span></>}
      </li>
    ))
  }
</ul>
