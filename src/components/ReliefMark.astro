---
/*
  ReliefMark — símbolo de estado de un proyecto, en el lenguaje de una carta
  de relieve (dirección "relieve luminoso", §6):

    ▲  punto trig   → en curso
    ○  collado      → en armado
    ·  sin relevar  → todo lo demás / [otros]

  Decorativo: el estado también va escrito al lado. aria-hidden.
*/
interface Props {
  estado: string;
}
const { estado } = Astro.props;
const s = estado.toLowerCase();
const kind = /curso|progress/.test(s) ? 'trig' : /armado|building|armar/.test(s) ? 'saddle' : 'unsurveyed';
---

<svg class="relief-mark" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" data-kind={kind}>
  {kind === 'trig' && <path d="M8 2 L14 13 L2 13 Z" fill="none" stroke="currentColor" stroke-width="1.4" />}
  {kind === 'saddle' && <circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.4" />}
  {kind === 'unsurveyed' && <circle cx="8" cy="8" r="1.8" fill="currentColor" />}
</svg>
