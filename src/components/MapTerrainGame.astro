---
/*
  MapTerrainGame — nivel 2 del juego. Un mapa en lenguaje cartográfico (trazo
  tenue, sin color) con cinco accidentes sin rotular; hay que arrastrar cada
  símbolo al lugar que le corresponde. También sirve tocar el símbolo y después
  el lugar (fallback de touch y de teclado). Isla de JS (§4). Sin animación con
  prefers-reduced-motion.
*/
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

const T = {
  es: {
    instr: 'Arrastrá cada símbolo hasta el accidente del mapa que le corresponde. También podés tocar el símbolo y después el lugar.',
    again: 'de nuevo',
    done: 'terreno reconocido',
    of: 'de',
    nojs: 'Este nivel necesita JavaScript.',
  },
  en: {
    instr: 'Drag each symbol onto the feature of the map it belongs to. You can also tap the symbol and then the place.',
    again: 'again',
    done: 'terrain read',
    of: 'of',
    nojs: 'This level needs JavaScript.',
  },
}[lang];

// id -> etiqueta + centro del accidente, en unidades del viewBox (0..120 x 0..78).
const VBW = 120;
const VBH = 78;
const spots = [
  { id: 'cima', es: 'cima', en: 'summit', vx: 32, vy: 38 },
  { id: 'agua', es: 'curso de agua', en: 'watercourse', vx: 55, vy: 41 },
  { id: 'sendero', es: 'sendero', en: 'footpath', vx: 72, vy: 51 },
  { id: 'bosque', es: 'bosque', en: 'woodland', vx: 96, vy: 55 },
  { id: 'depresion', es: 'depresión', en: 'depression', vx: 46, vy: 13 },
];

const symbolSvg: Record<string, string> = {
  cima: '<path d="M20 7 L33 31 L7 31 Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="20" cy="31" r="2" fill="currentColor"/>',
  agua: '<path d="M5 15 q5 -6 10 0 t10 0 t10 0" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 25 q5 -6 10 0 t10 0 t10 0" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  sendero: '<path d="M5 20 h30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-dasharray="4 3" stroke-linecap="round"/>',
  depresion: '<circle cx="20" cy="20" r="11" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 9 v4 M20 27 v4 M9 20 h4 M27 20 h4" stroke="currentColor" stroke-width="1.6"/>',
  bosque: '<path d="M20 8 l7 14 h-14 z" fill="currentColor"/><rect x="18.5" y="21" width="3" height="7" fill="currentColor"/>',
};
---

<div class="mtg" data-total={spots.length}>
  <p class="mtg-instr">{T.instr}</p>
  <noscript><p class="nota">{T.nojs}</p></noscript>

  <div class="mtg-map">
    <svg viewBox="0 0 120 78" class="mtg-terrain" role="img" aria-label={lang === 'es' ? 'Carta topográfica estilizada' : 'Stylised topographic map'}>
      {/* curvas de nivel normales */}
      <g fill="none" stroke="currentColor" stroke-width="0.45" opacity="0.4" stroke-linejoin="round">
        {/* colina, cima ~ (32, 38) */}
        <path d="M9 46 C6 30 16 18 32 17 C50 16 58 30 52 46 C47 60 26 62 15 52 C11 50 9 48 9 46 Z" />
        <path d="M15 44 C13 32 22 24 32 24 C46 24 51 34 47 45 C43 56 26 57 18 49 C15 47 15 45 15 44 Z" />
        <path d="M21 42 C20 34 26 29 32 30 C42 30 45 37 42 44 C39 51 27 51 23 45 C21 44 21 43 21 42 Z" />
        <path d="M27 40 C27 35 30 32 33 34 C38 35 39 41 36 44 C33 47 28 46 27 42 Z" />
        {/* cordón sobre el borde derecho */}
        <path d="M120 6 C104 10 99 22 103 36 C107 50 102 62 110 74" />
        <path d="M120 15 C107 19 102 29 105 40 C108 51 104 60 111 70" />
        <path d="M120 24 C110 27 106 34 108 43 C110 52 107 58 113 66" />
        {/* depresión: anillo exterior + interior con marcas hacia adentro (centro ~ 46,13) */}
        <path d="M31 6 C33 1 44 -1 53 1 C63 3 65 14 60 21 C55 28 40 27 34 20 C31 17 30 11 31 6 Z" />
        <path d="M37 8 C39 4 45 3 51 5 C57 7 58 15 54 19 C50 23 41 22 38 17 C36 15 36 11 37 8 Z" />
      </g>

      {/* curva índice (más marcada) */}
      <g fill="none" stroke="currentColor" stroke-width="0.85" opacity="0.6">
        <path d="M120 33 C112 35 109 40 110 47 C111 54 109 58 114 63" />
      </g>

      {/* marcas de la depresión */}
      <g fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5">
        <path d="M42 7 l1.6 2.6 M48 5.6 l-0.6 2.8 M53 10 l-2.6 1 M52 17 l-2 -2 M43 20 l0.9 -2.6 M37 13 l2.6 0.6" />
      </g>

      {/* curso de agua + un afluente */}
      <g fill="none" stroke="currentColor" stroke-width="0.55" opacity="0.5" stroke-linecap="round">
        <path d="M66 4 C64 12 68 17 63 24 C58 31 63 36 56 42 C49 48 52 55 43 60 C37 63 30 66 20 72" />
        <path d="M84 16 C79 21 74 22 66 24 C64.5 24.4 63.6 24.2 63 24" />
      </g>

      {/* sendero */}
      <path d="M8 74 C22 68 30 64 40 63 C52 61 60 55 70 52 C84 48 96 46 120 40"
        fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55" stroke-dasharray="2 1.5" stroke-linecap="round" />

      {/* bosque: límite de vegetación + coníferas (centro ~ 98, 56) */}
      <path d="M82 62 C80 50 92 44 105 46 C118 48 119 60 113 66 C107 73 90 74 84 68 C82 66 82 64 82 62 Z"
        fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.4" stroke-dasharray="0.7 1.1" />
      <g fill="currentColor" opacity="0.42">
        <path d="M88 58 l1.5 3 h-3 z" /><path d="M95 52 l1.5 3 h-3 z" /><path d="M102 57 l1.5 3 h-3 z" />
        <path d="M108 53 l1.5 3 h-3 z" /><path d="M90 66 l1.5 3 h-3 z" /><path d="M98 67 l1.5 3 h-3 z" />
        <path d="M105 63 l1.5 3 h-3 z" /><path d="M112 60 l1.5 3 h-3 z" /><path d="M100 61 l1.5 3 h-3 z" />
      </g>

      {/* mobiliario de carta */}
      <g opacity="0.5" fill="currentColor" stroke="currentColor">
        <path d="M4 4 v6 M4 4 h6" fill="none" stroke-width="0.5" />
        <text x="7.5" y="6.6" font-size="2.6" stroke="none">34°55′S</text>
        <text x="112" y="46" font-size="2.6" stroke="none">180</text>
        <path d="M115 4 v6 M115 4 l-1.5 2 M115 4 l1.5 2" fill="none" stroke-width="0.5" />
        <text x="113.5" y="13" font-size="2.8" stroke="none">N</text>
        <rect x="6" y="74" width="3" height="1.1" stroke="none" />
        <rect x="9" y="74" width="3" height="1.1" fill="none" stroke-width="0.3" />
        <rect x="12" y="74" width="3" height="1.1" stroke="none" />
        <rect x="15" y="74" width="3" height="1.1" fill="none" stroke-width="0.3" />
        <text x="6" y="72.6" font-size="2.3" stroke="none">0</text>
        <text x="15.5" y="72.6" font-size="2.3" stroke="none">500 m</text>
      </g>
    </svg>

    {
      spots.map((s) => (
        <button
          type="button"
          class="mtg-hotspot"
          data-id={s.id}
          style={`left:${s.vx}%;top:${(s.vy / VBH) * 100}%`}
          aria-label={lang === 'es' ? s.es : s.en}
        />
      ))
    }
  </div>

  <ul class="mtg-tray">
    {
      spots.map((s) => (
        <li>
          <button type="button" class="mtg-tile" data-id={s.id}>
            <svg viewBox="0 0 40 40" width="30" height="30" aria-hidden="true" set:html={symbolSvg[s.id]} />
            <span>{lang === 'es' ? s.es : s.en}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="mtg-foot">
    <span class="mtg-status" data-of={T.of} data-done={T.done}>0 {T.of} {spots.length}</span>
    <button type="button" class="mtg-again" hidden>{T.again}</button>
  </div>
</div>

<style>
  .mtg { max-width: var(--container); }
  .mtg-instr { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--space-4); }

  .mtg-map {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-fg);
    touch-action: none;
  }
  .mtg-terrain { display: block; width: 100%; height: auto; }
  .mtg-terrain text { font-family: var(--font-mono); letter-spacing: -0.02em; }

  .mtg-hotspot {
    position: absolute;
    width: 2.6rem;
    height: 2.6rem;
    transform: translate(-50%, -50%);
    border: 1px dashed transparent;
    border-radius: 50%;
    background: none;
    padding: 0;
    cursor: default;
  }
  .mtg.is-active .mtg-hotspot { border-color: color-mix(in srgb, var(--color-accent) 45%, transparent); }
  .mtg-hotspot.is-near { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 10%, transparent); }
  .mtg-hotspot[data-filled] { border-color: var(--color-accent); }
  .mtg-hotspot:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* .mtg-placed y su <svg> se crean por JS: no reciben el scope de Astro,
     así que se estilan con estilo inline en place(). */

  .mtg-tray {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .mtg-tile {
    font: inherit;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
    cursor: grab;
    touch-action: none;
  }
  .mtg-tile svg { color: var(--color-accent); flex: none; }
  .mtg-tile span { font-family: var(--font-mono); font-size: var(--text-xs); }
  .mtg-tile:hover { border-color: var(--color-accent); }
  .mtg-tile[aria-pressed='true'] { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg)); }
  .mtg-tile[data-done] { opacity: 0.4; cursor: default; }
  .mtg-tile.mtg-wrong { animation: mtg-shake 0.32s; border-color: var(--color-pop); }
  @keyframes mtg-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  .mtg-ghost {
    position: fixed;
    z-index: 50;
    pointer-events: none;
    opacity: 0.9;
    box-shadow: 0 8px 20px -8px rgba(20, 30, 40, 0.4);
  }

  .mtg-foot {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .mtg-status[data-complete] { color: var(--color-pop); }
  .mtg-again {
    font: inherit;
    font-family: var(--font-mono);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    color: var(--color-accent);
    cursor: pointer;
  }
  .mtg-again:hover { border-color: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .mtg-tile.mtg-wrong { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('.mtg').forEach((root) => {
    const map = root.querySelector<HTMLElement>('.mtg-map')!;
    const tray = root.querySelector<HTMLElement>('.mtg-tray')!;
    const hotspots = Array.from(root.querySelectorAll<HTMLButtonElement>('.mtg-hotspot'));
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.mtg-tile'));
    const status = root.querySelector<HTMLElement>('.mtg-status')!;
    const again = root.querySelector<HTMLButtonElement>('.mtg-again')!;
    const total = Number(root.dataset.total || '0');
    const ofWord = status.dataset.of || 'of';
    const doneWord = status.dataset.done || 'done';

    let picked: HTMLButtonElement | null = null;
    let solved = 0;
    let drag: { tile: HTMLButtonElement; id: string; ghost: HTMLElement | null; sx: number; sy: number; moved: boolean } | null = null;
    let justDragged = false;

    function setStatus() {
      if (solved >= total) {
        status.textContent = doneWord;
        status.dataset.complete = 'true';
        again.hidden = false;
        root.classList.remove('is-active');
      } else {
        status.textContent = `${solved} ${ofWord} ${total}`;
      }
    }

    function place(tile: HTMLButtonElement, hs: HTMLButtonElement) {
      hs.dataset.filled = 'true';
      tile.dataset.done = 'true';
      tile.setAttribute('aria-pressed', 'false');
      const mark = document.createElement('div');
      mark.className = 'mtg-placed';
      Object.assign(mark.style, {
        position: 'absolute',
        left: hs.style.left,
        top: hs.style.top,
        width: '2rem',
        height: '2rem',
        transform: 'translate(-50%, -50%)',
        color: 'var(--color-accent)',
        pointerEvents: 'none',
      });
      const svg = tile.querySelector('svg');
      if (svg) {
        const c = svg.cloneNode(true) as SVGElement;
        c.setAttribute('width', '100%');
        c.setAttribute('height', '100%');
        c.style.display = 'block';
        mark.appendChild(c);
      }
      map.appendChild(mark);
      solved++;
      setStatus();
    }

    function shake(tile: HTMLButtonElement) {
      tile.classList.add('mtg-wrong');
      setTimeout(() => tile.classList.remove('mtg-wrong'), 340);
    }

    function hotspotAt(x: number, y: number): HTMLButtonElement | null {
      let best: HTMLButtonElement | null = null;
      let bestD = 44; // radio de tolerancia en px
      for (const hs of hotspots) {
        if (hs.dataset.filled) continue;
        const r = hs.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const d = Math.hypot(x - cx, y - cy);
        if (d < bestD) {
          bestD = d;
          best = hs;
        }
      }
      return best;
    }

    function clearNear() {
      hotspots.forEach((h) => h.classList.remove('is-near'));
    }

    // ---- arrastre con pointer events ----
    tiles.forEach((tile) => {
      tile.addEventListener('pointerdown', (e) => {
        if (tile.dataset.done) return;
        tile.setPointerCapture(e.pointerId);
        drag = { tile, id: tile.dataset.id || '', ghost: null, sx: e.clientX, sy: e.clientY, moved: false };
      });

      tile.addEventListener('pointermove', (e) => {
        if (!drag || drag.tile !== tile) return;
        const dist = Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy);
        if (!drag.moved && dist < 6) return;
        drag.moved = true;
        root.classList.add('is-active');
        if (!drag.ghost) {
          const g = tile.cloneNode(true) as HTMLElement;
          g.className = 'mtg-tile mtg-ghost';
          document.body.appendChild(g);
          drag.ghost = g;
        }
        const r = drag.ghost.getBoundingClientRect();
        drag.ghost.style.left = e.clientX - r.width / 2 + 'px';
        drag.ghost.style.top = e.clientY - r.height / 2 + 'px';
        clearNear();
        const hs = hotspotAt(e.clientX, e.clientY);
        if (hs) hs.classList.add('is-near');
      });

      tile.addEventListener('pointerup', (e) => {
        if (!drag || drag.tile !== tile) return;
        const wasDrag = drag.moved;
        if (drag.ghost) drag.ghost.remove();
        if (wasDrag) {
          const hs = hotspotAt(e.clientX, e.clientY);
          if (hs && hs.dataset.id === drag.id) place(tile, hs);
          else shake(tile);
          justDragged = true;
          setTimeout(() => (justDragged = false), 60);
        }
        clearNear();
        if (solved < total) root.classList.toggle('is-active', !!picked);
        drag = null;
      });
    });

    // ---- fallback: tocar símbolo, después lugar ----
    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        if (justDragged || tile.dataset.done) return;
        if (picked === tile) {
          picked = null;
          tile.setAttribute('aria-pressed', 'false');
          root.classList.remove('is-active');
          return;
        }
        if (picked) picked.setAttribute('aria-pressed', 'false');
        picked = tile;
        tile.setAttribute('aria-pressed', 'true');
        root.classList.add('is-active');
      });
    });

    hotspots.forEach((hs) => {
      hs.addEventListener('click', () => {
        if (!picked || hs.dataset.filled) return;
        if (hs.dataset.id === picked.dataset.id) place(picked, hs);
        else shake(picked);
        picked.setAttribute('aria-pressed', 'false');
        picked = null;
        if (solved < total) root.classList.remove('is-active');
      });
    });

    function reset() {
      solved = 0;
      picked = null;
      drag = null;
      map.querySelectorAll('.mtg-placed').forEach((m) => m.remove());
      hotspots.forEach((h) => {
        delete h.dataset.filled;
        h.classList.remove('is-near');
      });
      tiles.forEach((t) => {
        delete t.dataset.done;
        t.setAttribute('aria-pressed', 'false');
      });
      delete status.dataset.complete;
      again.hidden = true;
      root.classList.remove('is-active');
      setStatus();
    }

    again.addEventListener('click', reset);
    setStatus();
  });
</script>
