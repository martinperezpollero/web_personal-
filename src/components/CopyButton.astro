---
/*
  CopyButton — copia al portapapeles el texto visible de #target. Isla de
  JS puntual (CLAUDE.md §4): no hay forma de copiar sin JS. Es un <button>
  real, así que ya es operable por teclado (Enter/Space) sin nada extra;
  aria-live en el propio botón anuncia el cambio a lectores de pantalla.
*/
interface Props {
  target: string;
  label: string;
  labelDone: string;
}
const { target, label, labelDone } = Astro.props;
---

<button
  type="button"
  class="copy-btn"
  data-copy-target={target}
  data-label={label}
  data-label-done={labelDone}
  aria-live="polite"
>
  {label}
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const targetId = btn.dataset.copyTarget;
    const el = targetId ? document.getElementById(targetId) : null;
    if (!el) return;

    // Respaldo síncrono para cuando el Clipboard API no responde (algunos
    // navegadores/políticas de permisos lo dejan colgado sin resolver ni
    // rechazar en vez de fallar rápido).
    function copyFallback(text: string): boolean {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    }

    btn.addEventListener('click', async () => {
      const text = el.innerText.trim();
      let ok = false;
      try {
        await Promise.race([
          navigator.clipboard.writeText(text),
          new Promise((_, reject) => window.setTimeout(() => reject(new Error('timeout')), 1500)),
        ]);
        ok = true;
      } catch {
        ok = copyFallback(text);
      }
      if (!ok) return;
      btn.textContent = btn.dataset.labelDone ?? btn.dataset.label ?? '';
      btn.dataset.copied = 'true';
      window.setTimeout(() => {
        btn.textContent = btn.dataset.label ?? '';
        delete btn.dataset.copied;
      }, 2000);
    });
  });
</script>

<style>
  .copy-btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    color: var(--color-accent);
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }
  .copy-btn:hover { border-color: var(--color-accent); }
  .copy-btn[data-copied] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
</style>
