---
import LanguageSelector from './LanguageSelector.astro';
import { getLocaleFromPath } from '../i18n/utils';
import { ui } from '../i18n/ui';

const path = Astro.url.pathname;
const lang = getLocaleFromPath(path);
const t = ui[lang];
const projectsSeg = lang === 'es' ? 'proyectos' : 'projects';
const pubsSeg = lang === 'es' ? 'publicaciones' : 'publications';
---

<header class="site-header">
  <a class="site-name" href={`/${lang}/`}>Martín Pérez Pollero</a>
  <nav aria-label={t['nav.aria']}>
    <a href={`/${lang}/${projectsSeg}/`}>{t['nav.projects']}</a>
    <a href={`/${lang}/${pubsSeg}/`}>{t['nav.publications']}</a>
  </nav>
  <LanguageSelector path={path} />
</header>
