---
import LanguageSelector from './LanguageSelector.astro';
import { getLocaleFromPath } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { SITE_NAME, NAV, CV_URL } from '../consts';

const path = Astro.url.pathname;
const lang = getLocaleFromPath(path);
const t = ui[lang];
---

<header class="site-header">
  <a class="site-name" href={`/${lang}/`}>{SITE_NAME}</a>
  <nav aria-label={t['nav.aria']}>
    {
      NAV.map((item) =>
        item.kind === 'external' ? (
          <a href={CV_URL} rel="noopener">{t[`nav.${item.key}`]}</a>
        ) : (
          <a href={`/${lang}/${item[lang]}/`}>{t[`nav.${item.key}`]}</a>
        )
      )
    }
  </nav>
  <LanguageSelector path={path} />
</header>
