---
import { getLocaleFromPath } from '../i18n/utils';
import { ui } from '../i18n/ui';
import ScaleBar from './ScaleBar.astro';
import { SITE_NAME, CV_PATH } from '../consts';

const lang = getLocaleFromPath(Astro.url.pathname);
const equi = lang === 'es' ? 'equidistancia 10 m' : 'contour interval 10 m';
---

<footer class="site-footer">
  <span>{SITE_NAME} · Montevideo</span>
  <span class="site-footer-scale">
    <ScaleBar label={equi} />
    {/* TODO §10: subir el PDF del CV a public/cv/. */}
    <a href={CV_PATH}>CV (PDF)</a>
  </span>
  <span class="nota">{ui[lang]['footer.todo']}</span>
</footer>
