---
/*
  MapContourGame — nivel 3 del juego. Sobre una carta de curvas de nivel
  (dibujo propio, SVG) hay cinco puntos rotulados A–E a distintas alturas.
  Tocalos de menor a mayor cota, leyendo las curvas. Un solo mecanismo:
  clic en orden. Isla de JS (§4). Sin animación con prefers-reduced-motion.
*/
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

const T = {
  es: {
    instr: 'Ordená los puntos de menor a mayor altura. Tocá uno, después el siguiente.',
    again: 'de nuevo',
    done: 'cotas leídas',
    lowHigh: 'de menor a mayor:',
  },
  en: {
    instr: 'Put the points in order from lowest to highest. Tap one, then the next.',
    again: 'again',
    done: 'contours read',
    lowHigh: 'lowest to highest:',
  },
}[lang];

// letra + posición (% del mapa) + cota real (solo para el orden; no se muestra).
const points = [
  { letter: 'A', x: 12, y: 80, elev: 115 },
  { letter: 'B', x: 19, y: 53, elev: 150 },
  { letter: 'C', x: 71, y: 49, elev: 210 },
  { letter: 'D', x: 34, y: 77, elev: 130 },
  { letter: 'E', x: 56, y: 68, elev: 170 },
];
const order = [...points].sort((a, b) => a.elev - b.elev).map((p) => p.letter);
---

<div class="mcg" data-order={order.join('')}>
  <p class="mcg-instr">{T.instr}</p>

  <div class="mcg-map">
    <svg viewBox="0 0 120 76" class="mcg-terrain" role="img" aria-label={lang === 'es' ? 'Carta de curvas de nivel' : 'Contour map'}>
      <g fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.4" stroke-linejoin="round">
        {/* tierra baja, bottom-left (120) */}
        <path d="M2 76 C2 62 12 56 20 60 C28 64 26 76 20 78" />
        {/* cerro chico izquierda: 140, 160 */}
        <path d="M10 54 C8 40 20 32 31 34 C44 36 48 50 41 58 C34 66 18 66 12 57 C10 56 10 55 10 54 Z" />
        <path d="M19 50 C18 42 25 37 31 38 C39 39 41 48 36 53 C31 58 23 57 20 51 Z" />
        {/* cerro grande derecha: 140, 160, 180, 200 */}
        <path d="M52 58 C48 36 64 22 82 22 C102 22 112 40 105 58 C98 74 72 76 61 63 C55 60 54 59 52 58 Z" />
        <path d="M60 52 C58 36 72 27 84 27 C98 27 103 44 98 54 C93 64 73 65 66 55 Z" />
        <path d="M68 47 C67 38 76 32 84 33 C94 34 96 45 91 51 C86 57 74 55 70 48 Z" />
        <path d="M76 43 C76 37 80 34 84 35 C90 36 90 44 86 47 C82 50 78 47 76 43 Z" />
      </g>
      {/* rótulos de curvas índice */}
      <g fill="currentColor" opacity="0.5" font-size="3">
        <text x="6" y="70">120</text>
        <text x="9" y="52">140</text>
        <text x="19" y="45">160</text>
        <text x="49" y="55">140</text>
        <text x="58" y="49">160</text>
        <text x="66" y="44">180</text>
        <text x="73" y="41">200</text>
      </g>
    </svg>

    {
      points.map((p) => (
        <button type="button" class="mcg-point" data-letter={p.letter} style={`left:${p.x}%;top:${p.y}%`}>
          {p.letter}
        </button>
      ))
    }
  </div>

  <div class="mcg-foot">
    <span class="mcg-seq" data-lowhigh={T.lowHigh} data-done={T.done}>—</span>
    <button type="button" class="mcg-again" hidden>{T.again}</button>
  </div>
</div>

<style>
  .mcg { max-width: var(--container); }
  .mcg-instr { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--space-4); }

  .mcg-map {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-fg);
    line-height: 0;
  }
  .mcg-terrain { display: block; width: 100%; height: auto; }
  .mcg-terrain text { font-family: var(--font-mono); }

  .mcg-point {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .mcg-point:hover { background: color-mix(in srgb, var(--color-accent) 16%, var(--color-bg)); }
  .mcg-point:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .mcg-point[data-rank] {
    background: var(--color-accent);
    color: var(--color-accent-fg);
    cursor: default;
  }
  .mcg-point[data-rank]::after {
    content: attr(data-rank);
    position: absolute;
    top: -0.35rem;
    right: -0.35rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    font-size: 0.62rem;
    display: grid;
    place-items: center;
  }
  .mcg-point.mcg-wrong { animation: mcg-shake 0.32s; border-color: var(--color-pop); }
  @keyframes mcg-shake {
    0%, 100% { transform: translate(-50%, -50%); }
    25% { transform: translate(calc(-50% - 4px), -50%); }
    75% { transform: translate(calc(-50% + 4px), -50%); }
  }

  .mcg-foot {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .mcg-seq[data-complete] { color: var(--color-pop); }
  .mcg-again {
    font: inherit;
    font-family: var(--font-mono);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    color: var(--color-accent);
    cursor: pointer;
  }
  .mcg-again:hover { border-color: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .mcg-point.mcg-wrong { animation: none; }
    .mcg-point { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('.mcg').forEach((root) => {
    const order = (root.dataset.order || '').split('');
    const points = Array.from(root.querySelectorAll<HTMLButtonElement>('.mcg-point'));
    const seq = root.querySelector<HTMLElement>('.mcg-seq')!;
    const again = root.querySelector<HTMLButtonElement>('.mcg-again')!;
    const lowHigh = seq.dataset.lowhigh || '';
    const doneWord = seq.dataset.done || '';
    let next = 0;

    function render() {
      const got = order.slice(0, next);
      if (next >= order.length) {
        seq.textContent = `${doneWord} · ${order.join(' · ')}`;
        seq.dataset.complete = 'true';
        again.hidden = false;
      } else {
        seq.textContent = got.length ? `${lowHigh} ${got.join(' · ')} …` : '—';
      }
    }

    points.forEach((pt) => {
      pt.addEventListener('click', () => {
        if (pt.dataset.rank || next >= order.length) return;
        if (pt.dataset.letter === order[next]) {
          next++;
          pt.dataset.rank = String(next);
          render();
        } else {
          pt.classList.add('mcg-wrong');
          setTimeout(() => pt.classList.remove('mcg-wrong'), 340);
        }
      });
    });

    again.addEventListener('click', () => {
      next = 0;
      points.forEach((pt) => delete pt.dataset.rank);
      delete seq.dataset.complete;
      again.hidden = true;
      render();
    });

    render();
  });
</script>
