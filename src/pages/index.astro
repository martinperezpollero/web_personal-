---
// Raíz: detecta el idioma del navegador y redirige (CLAUDE.md §5).
// Salida estática => no hay servidor que lea cabeceras: se resuelve con un
// script mínimo en cliente. Es una de las excepciones de JS permitidas
// (CLAUDE.md §4). Sin JS, el <meta refresh> lleva a /es/ y quedan los dos enlaces.
// GitHub Pages es hosting estático puro (sin motor de reglas de servidor):
// no hay forma de emitir un 301/302 real para "/". El <meta refresh content="0">
// es la mejor aproximación disponible con este hosting — Google lo trata como
// una redirección a efectos de indexación.
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Martín Pérez Pollero</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`${site}/es/`} />
    <link rel="alternate" hreflang="es" href={`${site}/es/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/es/`} />
    <script is:inline>
      (function () {
        try {
          var l =
            (navigator.languages && navigator.languages[0]) || navigator.language || 'es';
          location.replace(l.toLowerCase().indexOf('en') === 0 ? '/en/' : '/es/');
        } catch (e) {
          location.replace('/es/');
        }
      })();
    </script>
    <meta http-equiv="refresh" content="0; url=/es/" />
  </head>
  <body>
    <p>Redirigiendo… · <a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
