---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Coord from '../../components/Coord.astro';
import Portrait from '../../components/Portrait.astro';
import { ui } from '../../i18n/ui';
import { BASE_COORD } from '../../consts';

const entry = (await getCollection('bioEs'))[0];
const { Content } = entry ? await render(entry) : { Content: null };
const linea = entry?.data.linea?.trim();
const parrafo = entry?.data.parrafo?.trim();
const tieneLarga = !!entry?.body?.replace(/<!--[\s\S]*?-->/g, '').trim();
---

<BaseLayout
  title="bio — Martín Pérez Pollero"
  description="Biografía de Martín Pérez Pollero para prensa, comités y presentaciones."
>
  <div class="hero">
    <div class="hero-text">
      <Coord fix={BASE_COORD.es.fix} place={BASE_COORD.es.place} />
      <h1>bio</h1>
      {linea ? <p class="lede">{linea}</p> : <p class="lede nota"><em>{ui.es['home.bio.linea']}</em></p>}
      {parrafo ? <p>{parrafo}</p> : <p class="nota"><em>{ui.es['home.bio.parrafo']}</em></p>}
    </div>
    <Portrait size="lg" />
  </div>

  <section class="home-block">
    <h2>larga</h2>
    {tieneLarga && Content ? <Content /> : <p class="nota"><em>{ui.es['bio.larga.todo']}</em></p>}
  </section>
</BaseLayout>
