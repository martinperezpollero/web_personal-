---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import Coord from '../../components/Coord.astro';
import { ui } from '../../i18n/ui';
import { CV_URL } from '../../consts';
import publications from '../../data/publications.json';
import type { CslItem } from '../../lib/csl';

// CSL-JSON exportado de Zotero (CLAUDE.md §7). No se edita a mano.
// Mientras no haya export, esto es []. Para ver el diseño con datos:
// cp src/data/publications.sample.json src/data/publications.json
const items = publications as CslItem[];
---

<BaseLayout
  title="publicaciones — Martín Pérez Pollero"
  description="Selección de publicaciones de Martín Pérez Pollero."
>
  <Coord fix="hoja 3 · registro" />
  <h1>publicaciones</h1>
  <p>Una selección. El CV completo está en <a href={CV_URL} rel="noopener">CVUy</a>.</p>

  {items.length === 0 && <p class="nota"><em>{ui.es['publications.empty']}</em></p>}
  <PublicationList items={items} lang="es" />
</BaseLayout>
