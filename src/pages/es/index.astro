---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import Coord from '../../components/Coord.astro';
import ReliefMark from '../../components/ReliefMark.astro';
import Portrait from '../../components/Portrait.astro';
import Contact from '../../components/Contact.astro';
import { ui } from '../../i18n/ui';
import { BASE_COORD } from '../../consts';
import publications from '../../data/publications.json';
import type { CslItem } from '../../lib/csl';

const proyectos = (await getCollection('proyectos'))
  .filter((p) => !p.data.borrador)
  .sort((a, b) => a.data.orden - b.data.orden);

const pubs = publications as CslItem[];

const bio = (await getCollection('bioEs'))[0]?.data;
const linea = bio?.linea?.trim();
const parrafo = bio?.parrafo?.trim();
---

<BaseLayout title="Martín Pérez Pollero" description="Hub personal de Martín Pérez Pollero.">
  <div class="hero">
    <div class="hero-text">
      <Coord fix={BASE_COORD.es.fix} place={BASE_COORD.es.place} />
      <h1>Martín Pérez Pollero</h1>
      {/* La bio vive en src/content/es/bio.md (§7). Mientras esté vacía, TODO. */}
      {linea ? <p class="lede">{linea}</p> : <p class="lede nota"><em>{ui.es['home.bio.linea']}</em></p>}
      {parrafo ? <p>{parrafo}</p> : <p class="nota"><em>{ui.es['home.bio.parrafo']}</em></p>}
      <p><a href="/es/bio/">{ui.es['bio.long.link']}</a></p>
    </div>
    <Portrait size="sm" />
  </div>

  <section class="home-block">
    <h2>proyectos</h2>
    {proyectos.length === 0 && <p class="nota"><em>{ui.es['projects.empty']}</em></p>}
    <ul class="home-list">
      {proyectos.slice(0, 3).map((p) => (
        <li>
          <ReliefMark estado={p.data.estado} />
          {p.data.enlaceExterno ? <a href={p.data.enlaceExterno}>{p.data.titulo}</a> : p.data.titulo}
          <span class="meta meta--dato">
            {' — '}
            <span class:list={['estado', /curso/i.test(p.data.estado) && 'estado--activo']}>{p.data.estado}</span>
          </span>
        </li>
      ))}
    </ul>
    <p><a href="/es/proyectos/">todos los proyectos →</a></p>
  </section>

  <section class="home-block">
    <h2>publicaciones</h2>
    {pubs.length === 0 && <p class="nota"><em>{ui.es['publications.empty']}</em></p>}
    <PublicationList items={pubs} lang="es" limit={3} />
    <p><a href="/es/publicaciones/">todas las publicaciones →</a></p>
  </section>

  <section class="home-block">
    <h2>{ui.es['contact.title']}</h2>
    <Contact />
  </section>
</BaseLayout>
