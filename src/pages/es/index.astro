---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import Coord from '../../components/Coord.astro';
import ReliefMark from '../../components/ReliefMark.astro';
import { ui } from '../../i18n/ui';
import publications from '../../data/publications.json';
import type { CslItem } from '../../lib/csl';

const proyectos = (await getCollection('proyectos'))
  .filter((p) => !p.data.borrador)
  .sort((a, b) => a.data.orden - b.data.orden);

const pubs = publications as CslItem[];
---

<BaseLayout title="Martín Pérez Pollero" description="Hub personal de Martín Pérez Pollero.">
  <Coord fix="34°54′S 56°11′O" place="Montevideo" />
  <h1>Martín Pérez Pollero</h1>

  {/* CLAUDE.md §2 «Bio: tres longitudes». No inventar: escribir a mano.
      Decidir antes «una línea o dos» (§11.3). */}
  <p class="lede"><em>TODO: una línea de presentación.</em></p>
  <p><em>TODO: un párrafo de bio (la convergencia de las dos líneas de trabajo).</em></p>

  <section class="home-block">
    <h2>proyectos</h2>
    {proyectos.length === 0 && <p class="nota"><em>{ui.es['projects.empty']}</em></p>}
    <ul class="home-list">
      {proyectos.map((p) => (
        <li>
          <ReliefMark estado={p.data.estado} />
          {p.data.enlaceExterno ? <a href={p.data.enlaceExterno}>{p.data.titulo}</a> : p.data.titulo}
          <span class="meta meta--dato">
            {' — '}
            <span class:list={['estado', /curso/i.test(p.data.estado) && 'estado--activo']}>{p.data.estado}</span>
          </span>
        </li>
      ))}
      <li class="fantasma"><ReliefMark estado="sin relevar" />[otros]<span class="meta meta--dato"> — sin relevar</span></li>
    </ul>
    <p><a href="/es/proyectos/">todos los proyectos →</a></p>
  </section>

  <section class="home-block">
    <h2>publicaciones</h2>
    {pubs.length === 0 && <p class="nota"><em>{ui.es['publications.empty']}</em></p>}
    <PublicationList items={pubs} lang="es" limit={4} />
    <p><a href="/es/publicaciones/">todas las publicaciones →</a></p>
  </section>

  <section class="home-block">
    <h2>contacto</h2>
    {/* TODO §10: correo público, ORCID, y perfiles (CVUy, Scholar, LinkedIn, Bluesky). */}
    <p class="nota"><em>TODO: correo público y perfiles.</em></p>
  </section>
</BaseLayout>
