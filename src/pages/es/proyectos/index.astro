---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Coord from '../../../components/Coord.astro';
import ReliefMark from '../../../components/ReliefMark.astro';
import { ui } from '../../../i18n/ui';

const proyectos = (await getCollection('proyectos'))
  .filter((p) => !p.data.borrador)
  .sort((a, b) => a.data.orden - b.data.orden);

// Mismos símbolos de carta que Contact.astro / PublicationList.astro / el
// juego: marca distintiva para proyectos sin logo propio (§6).
const MARKS: Record<string, string> = {
  coordenada: '<path d="M20 6 v28 M6 20 h28" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="20" cy="20" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  sendero: '<path d="M5 20 h30" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round"/>',
  cima: '<path d="M20 7 L33 31 L7 31 Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="20" cy="31" r="2.2" fill="currentColor"/>',
  depresion: '<circle cx="20" cy="20" r="11" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M20 9 v4 M20 27 v4 M9 20 h4 M27 20 h4" stroke="currentColor" stroke-width="1.8"/>',
  agua: '<path d="M5 15 q5 -6 10 0 t10 0 t10 0" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 25 q5 -6 10 0 t10 0 t10 0" fill="none" stroke="currentColor" stroke-width="1.8"/>',
  bosque: '<path d="M20 8 l7 14 h-14 z" fill="currentColor"/><rect x="18.5" y="21" width="3" height="7" fill="currentColor"/>',
};
---

<BaseLayout
  title="proyectos — Martín Pérez Pollero"
  description="Proyectos de Martín Pérez Pollero. En curso y finalizados."
>
  <Coord fix="hoja 2 · índice de accidentes" />
  <h1>proyectos</h1>
  <p>Proyectos en curso y finalizados.</p>

  {proyectos.length === 0 && <p class="nota"><em>{ui.es['projects.empty']}</em></p>}

  {
    proyectos.map(async (p) => {
      const { Content } = await render(p);
      return (
        <article>
          <h2>
            {p.data.logo ? (
              <img class="project-logo" src={p.data.logo} alt="" aria-hidden="true" />
            ) : p.data.mark ? (
              <svg class="project-mark" viewBox="0 0 40 40" aria-hidden="true" set:html={MARKS[p.data.mark]} />
            ) : (
              <ReliefMark estado={p.data.estado} />
            )}
            {p.data.enlaceExterno ? (
              <a href={p.data.enlaceExterno}>{p.data.titulo}</a>
            ) : (
              p.data.titulo
            )}
          </h2>
          <p class="meta meta--dato">
            <span class:list={['estado', /curso/i.test(p.data.estado) && 'estado--activo']}>
              {p.data.estado}
            </span>
            {p.data.periodo && <> · {p.data.periodo}</>}
            {' · '}
            {p.data.coordenada
              ? `${p.data.coordenada}${p.data.sede ? ` ${p.data.sede}` : ''}`
              : 'coordenada por asignar'}
            {p.data.rol && <> · {p.data.rol}</>}
            {' · '}
            {p.data.idiomasDisponibles.join('/')}
          </p>
          {p.data.resumen && <p>{p.data.resumen}</p>}
          <Content />
          {p.data.colaboradores.length > 0 && (
            <p class="meta">con {p.data.colaboradores.join(', ')}</p>
          )}
          {p.data.anclaje && (
            <p class="meta">
              {p.data.anclaje.url ? (
                <a href={p.data.anclaje.url}>{p.data.anclaje.cita}</a>
              ) : (
                p.data.anclaje.cita
              )}
            </p>
          )}
        </article>
      );
    })
  }

</BaseLayout>
