---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Coord from '../../components/Coord.astro';
import MapLegendGame from '../../components/MapLegendGame.astro';
import { ui } from '../../i18n/ui';
---

<BaseLayout
  title="juego — Martín Pérez Pollero"
  description="Leyenda: un micro-juego para unir cada elemento del terreno con su símbolo de carta."
>
  <Coord fix="hoja 4 · leyenda" />
  <h1>{ui.es['game.title']}</h1>
  <p class="lede">{ui.es['game.lede']}</p>

  <MapLegendGame lang="es" />

  <p class="nota" style="margin-top: var(--space-12)">{ui.es['game.body']}</p>
</BaseLayout>
