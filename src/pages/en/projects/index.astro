---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Coord from '../../../components/Coord.astro';
import ReliefMark from '../../../components/ReliefMark.astro';
import { ui } from '../../../i18n/ui';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.borrador)
  .sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout
  title="projects — Martín Pérez Pollero"
  description="Projects by Martín Pérez Pollero. Each one lives on its own site."
>
  <Coord fix="sheet 2 · index of features" />
  <h1>projects</h1>
  <p>Each project has its own site, design and pace. This is the index.</p>

  {projects.length === 0 && <p class="nota"><em>{ui.en['projects.empty']}</em></p>}

  {
    projects.map(async (p) => {
      const { Content } = await render(p);
      return (
        <article>
          <h2>
            <ReliefMark estado={p.data.estado} />
            {p.data.enlaceExterno ? (
              <a href={p.data.enlaceExterno}>{p.data.titulo}</a>
            ) : (
              p.data.titulo
            )}
          </h2>
          <p class="meta meta--dato">
            <span class:list={['estado', /curso|progress/i.test(p.data.estado) && 'estado--activo']}>
              {p.data.estado}
            </span>
            {p.data.periodo && <> · {p.data.periodo}</>}
            {' · '}
            {p.data.coordenada
              ? `${p.data.coordenada}${p.data.sede ? ` ${p.data.sede}` : ''}`
              : 'coordinate TBD'}
            {' · '}
            {p.data.idiomasDisponibles.join('/')}
          </p>
          <p>{p.data.resumen}</p>
          <Content />
          {p.data.colaboradores.length > 0 && (
            <p class="meta">with {p.data.colaboradores.join(', ')}</p>
          )}
          {p.data.anclaje && (
            <p class="meta">
              {p.data.anclaje.url ? (
                <a href={p.data.anclaje.url}>{p.data.anclaje.cita}</a>
              ) : (
                p.data.anclaje.cita
              )}
            </p>
          )}
        </article>
      );
    })
  }

  <article class="fantasma">
    <h2><ReliefMark estado="sin relevar" />[otros]</h2>
    <p class="meta meta--dato">unsurveyed</p>
  </article>
</BaseLayout>
