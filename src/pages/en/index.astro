---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import Coord from '../../components/Coord.astro';
import ReliefMark from '../../components/ReliefMark.astro';
import Portrait from '../../components/Portrait.astro';
import Contact from '../../components/Contact.astro';
import { ui } from '../../i18n/ui';
import { BASE_COORD } from '../../consts';
import publications from '../../data/publications.json';
import type { CslItem } from '../../lib/csl';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.borrador)
  .sort((a, b) => a.data.orden - b.data.orden);

const pubs = publications as CslItem[];

const bio = (await getCollection('bioEn'))[0]?.data;
const linea = bio?.linea?.trim();
const parrafo = bio?.parrafo?.trim();
---

<BaseLayout title="Martín Pérez Pollero" description="Personal hub of Martín Pérez Pollero.">
  <div class="hero">
    <div class="hero-text">
      <Coord fix={BASE_COORD.en.fix} place={BASE_COORD.en.place} />
      <h1>Martín Pérez Pollero</h1>
      {/* Bio lives in src/content/en/bio.md (§7). While empty, TODO. */}
      {linea ? <p class="lede">{linea}</p> : <p class="lede nota"><em>{ui.en['home.bio.linea']}</em></p>}
      {parrafo ? <p>{parrafo}</p> : <p class="nota"><em>{ui.en['home.bio.parrafo']}</em></p>}
      <p><a href="/en/bio/">{ui.en['bio.long.link']}</a></p>
    </div>
    <Portrait size="sm" />
  </div>

  <section class="home-block">
    <h2>projects</h2>
    {projects.length === 0 && <p class="nota"><em>{ui.en['projects.empty']}</em></p>}
    <ul class="home-list">
      {projects.map((p) => (
        <li>
          <ReliefMark estado={p.data.estado} />
          {p.data.enlaceExterno ? <a href={p.data.enlaceExterno}>{p.data.titulo}</a> : p.data.titulo}
          <span class="meta meta--dato">
            {' — '}
            <span class:list={['estado', /curso|progress/i.test(p.data.estado) && 'estado--activo']}>{p.data.estado}</span>
          </span>
        </li>
      ))}
      <li class="fantasma"><ReliefMark estado="sin relevar" />[otros]<span class="meta meta--dato"> — unsurveyed</span></li>
    </ul>
    <p><a href="/en/projects/">all projects →</a></p>
  </section>

  <section class="home-block">
    <h2>publications</h2>
    {pubs.length === 0 && <p class="nota"><em>{ui.en['publications.empty']}</em></p>}
    <PublicationList items={pubs} lang="en" limit={4} />
    <p><a href="/en/publications/">all publications →</a></p>
  </section>

  <section class="home-block">
    <h2>{ui.en['contact.title']}</h2>
    <Contact />
  </section>
</BaseLayout>
