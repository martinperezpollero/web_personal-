---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Coord from '../../components/Coord.astro';
import MapLegendGame from '../../components/MapLegendGame.astro';
import { ui } from '../../i18n/ui';
---

<BaseLayout
  title="game — Martín Pérez Pollero"
  description="Legend: a mini-game to match each feature of the terrain with its map symbol."
>
  <Coord fix="sheet 4 · legend" />
  <h1>{ui.en['game.title']}</h1>
  <p class="lede">{ui.en['game.lede']}</p>

  <MapLegendGame lang="en" />

  <p class="nota" style="margin-top: var(--space-12)">{ui.en['game.body']}</p>
</BaseLayout>
