---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import Coord from '../../components/Coord.astro';
import { ui } from '../../i18n/ui';
import { CV_URL } from '../../consts';
import publications from '../../data/publications.json';
import type { CslItem } from '../../lib/csl';

// CSL-JSON exported from Zotero (CLAUDE.md §7). Not edited by hand.
const items = publications as CslItem[];
---

<BaseLayout
  title="publications — Martín Pérez Pollero"
  description="Selected publications by Martín Pérez Pollero."
>
  <Coord fix="sheet 3 · record" />
  <h1>publications</h1>
  <p>A selection. The full CV is on <a href={CV_URL} rel="noopener">CVUy</a>.</p>

  {items.length === 0 && <p class="nota"><em>{ui.en['publications.empty']}</em></p>}
  <PublicationList items={items} lang="en" />
</BaseLayout>
