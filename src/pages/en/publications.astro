---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import { ui } from '../../i18n/ui';
import publications from '../../data/publications.json';
import type { CslItem } from '../../lib/csl';

// CSL-JSON exported from Zotero (CLAUDE.md §7). Not edited by hand.
const items = publications as CslItem[];
---

<BaseLayout
  title="publications — Martín Pérez Pollero"
  description="Selected publications by Martín Pérez Pollero."
>
  <h1>publications</h1>
  {/* TODO §10: add the PDF to public/cv/ with this name. */}
  <p>A selection. The full CV is a <a href="/cv/cv-martin-perez-pollero-2026.pdf">PDF</a>.</p>

  {items.length === 0 && <p class="nota"><em>{ui.en['publications.empty']}</em></p>}
  <PublicationList items={items} lang="en" />
</BaseLayout>
